{
  "name": "@capability-control-plane/docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=25.5.0",
    "pnpm": "10.26.0"
  },
  "scripts": {
    "dev": "node scripts/build-machine-projection.mjs && astro dev",
    "build": "node scripts/build-machine-projection.mjs && astro check && astro build && node scripts/verify-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:client": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck ../generated/clients/typescript/capability-protocol.ts",
    "test": "node --test tests/**/*.test.mjs",
    "verify": "pnpm run test && pnpm run check:client && pnpm run build"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
