---
interface Props {
  path: string;
  label: string;
}

const { path, label } = Astro.props;
if (
  !(
    /^[A-Za-z0-9_/-]+\.mdx?$/u.test(path) ||
    path === "sumi-docs-manifest.json"
  ) ||
  path.includes("//") ||
  path.split("/").includes("..")
) {
  throw new Error("CanonicalLink path must be a safe projected Markdown path.");
}
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const href = `${base}_mcp/${path}`;
---

<a href={href}>{label}</a>
